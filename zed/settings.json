// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // Extensions Zed installs on first start: the Ashen theme (set below) and language support
    "auto_install_extensions": {
        "ashen": true,
        "html": true,
        "sql": true,
        "zig": true,
    },
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "icon_theme": "Zed (Default)",
    "buffer_font_family": "JetBrainsMonoNL Nerd Font",
    "ui_font_family": "JetBrainsMonoNL Nerd Font",
    "vim_mode": true,
    "ui_font_size": 11,
    "buffer_font_size": 11,
    "terminal": {
        "toolbar": { "breadcrumbs": false },
        "font_family": "JetBrainsMonoNL Nerd Font",
    },
    "buffer_font_features": {
        "calt": false,
        "liga": false,
        "dlig": false,
    },
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Ashen",
    },
    "git": {
        "git_gutter": "hide",
        "inline_blame": {
            "enabled": false,
        },
    },
    "gutter": {
        "line_numbers": true,
    },
    "relative_line_numbers": "disabled",
    "diagnostics": {
        "inline": {
            "enabled": true,
        },
    },
    "disable_ai": true,
    "agent": {
        "dock": "right",
        "enabled": false,
        "single_file_review": false,
    },
    "tab_size": 4,
    "lsp": {},
    "languages": {
        "JavaScript": {
            "tab_size": 4,
            "enable_language_server": false,
        },
        "TypeScript": {
            "tab_size": 4,
            "enable_language_server": false,
        },
        "JSON": {
            "tab_size": 4,
            "enable_language_server": false,
        },
        "HTML": {
            "tab_size": 4,
            "enable_language_server": false
        },
        "Go": {
            "tab_size": 4,
            "enable_language_server": true,
        },
        "Zig": {
            "tab_size": 4,
            "enable_language_server": true,
        },
        "C": {
            "tab_size": 4,
            "enable_language_server": true,
        }
    },
    "file_types": {
        "HTML": ["gohtml", "html"]
    },
    "scrollbar": { "show": "never" },
    "inlay_hints": { "enabled": false },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "format_on_save": "off",
}
